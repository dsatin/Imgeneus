{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:imgeneus:ep45:extended-table-record:1",
  "title": "EP45 extended structural record",
  "type": "object",
  "required": [
    "id",
    "baseline_id",
    "archive_entry_id",
    "source_path",
    "source_sha256",
    "decoded_sha256",
    "schema_id",
    "status",
    "semantic_status",
    "client_id",
    "domain",
    "ordinal",
    "offset",
    "size_bytes",
    "group_ordinal",
    "texts",
    "numeric_blocks"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "baseline_id": {
      "type": "string"
    },
    "archive_entry_id": {
      "type": "string"
    },
    "source_path": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decoded_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "group_ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "group_record_ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "domain": {
      "enum": [
        "skills",
        "npc-skills",
        "priest-talk",
        "npcs",
        "quests"
      ]
    },
    "schema_id": {
      "const": "EP45-A2-EXTENDED-001"
    },
    "status": {
      "const": "decoded"
    },
    "semantic_status": {
      "const": "unknown"
    },
    "client_id": {
      "type": "null"
    },
    "texts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "numeric_blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "unknown_pairs": {
      "$ref": "#/$defs/sequence"
    },
    "unknown_lists": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/sequence"
      }
    },
    "unknown_results": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "unknown_targets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "numeric_blocks",
          "texts",
          "trailing_block"
        ],
        "properties": {
          "numeric_blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/$defs/block"
            }
          },
          "texts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "trailing_block": {
            "$ref": "#/$defs/block"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "object",
      "required": [
        "offset",
        "size_bytes",
        "length_raw_i32",
        "raw_hex",
        "text",
        "encoding_status",
        "trailing_zero_bytes"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "length_raw_i32": {
          "type": "integer",
          "minimum": 0
        },
        "raw_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoding_status": {
          "enum": [
            "ascii",
            "utf8_candidate",
            "unknown"
          ]
        },
        "trailing_zero_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": [
        "offset",
        "layout",
        "values"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "layout": {
          "type": "string",
          "pattern": "^<[BHIh]+$"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    },
    "sequence": {
      "type": "object",
      "required": [
        "offset",
        "declared_count",
        "entries"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "declared_count": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
