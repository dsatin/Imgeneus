{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:imgeneus:ep45:zon-record:1",
  "title": "EP45 ZON format-5 structural record",
  "type": "object",
  "required": [
    "id",
    "source_entry_id",
    "source_sha256",
    "baseline_id",
    "schema_id",
    "ordinal",
    "offset",
    "size_bytes",
    "texts",
    "numeric_blocks",
    "status",
    "semantic_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source_entry_id": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline_id": {
      "type": "string"
    },
    "schema_id": {
      "const": "EP45-A3-ZON-001"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 8
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 65
    },
    "texts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "numeric_blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "status": {
      "const": "decoded"
    },
    "semantic_status": {
      "const": "unknown"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "object",
      "required": [
        "offset",
        "size_bytes",
        "length_raw_i32",
        "raw_hex",
        "text",
        "encoding_status",
        "trailing_zero_bytes"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "length_raw_i32": {
          "type": "integer",
          "minimum": 0
        },
        "raw_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoding_status": {
          "enum": [
            "ascii",
            "utf8_candidate",
            "unknown"
          ]
        },
        "trailing_zero_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": [
        "offset",
        "layout",
        "values"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "layout": {
          "type": "string",
          "pattern": "^<[BHIh]+$"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
